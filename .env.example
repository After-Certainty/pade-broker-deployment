# Copy to .env and fill in. Never commit .env.
# No secrets belong here — only non-secret deployment identifiers.
# GitHub App PEM, GA service-account JSON, and Vercel/Sanity access tokens go to
# Secret Manager via Make (secret-github-app / secret-ga-sa /
# secret-vercel-token-subject / secret-sanity-token-subject), not this file.
# Recommended Vercel path: docs/milestone-m-wif.md (subject-secret-wif).
# Optional shared Vercel token: docs/milestone-l-vercel.md (static-token-file).
# Sanity rehearsal: docs/milestone-sanity-rehearsal.md (subject-secret-wif only).
#
# GitHub Actions production deploys do not use this file. Configure the same
# identifiers as GitHub Environment variables on environment "production"
# (plus WIF provider / deployer SA). App fields use GH_APP_ID /
# GH_APP_INSTALLATION_ID / GH_REPOSITORIES there (GitHub reserves GITHUB_*).
# See docs/github-actions.md.

# --- GCP (required) ---
PROJECT_ID=your-gcp-project-id
# Optional override; otherwise derived via gcloud from PROJECT_ID:
# PROJECT_NUMBER=123456789012

# --- GitHub App (non-secret IDs; PEM stays out of git) ---
# App ID and installation ID: GitHub → Settings → Developer settings → GitHub Apps
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_INSTALLATION_ID=your-installation-id
# Comma-separated owner/repo the App installation may mint tokens for
GITHUB_REPOSITORIES=owner/repo

# --- Google Analytics ---
# GA4 property resource name (Admin API / GA property settings)
GA_PROPERTY_ID=properties/123456789

# --- Cursor Cloud Agent identity ---
# From a Cursor Cloud Agent (identity socket present):
#   pade identity --audience "$(make -s predict-url)"
# Audience does not require the broker to be deployed yet.
#
# Primary allowlisted Cursor subject (required unless CURSOR_OIDC_SUBJECTS is set):
CURSOR_OIDC_SUBJECT=user:YOUR_CURSOR_SUBJECT
# Or comma-separated subjects for A/B isolation dogfood (same capability, different Material):
# CURSOR_OIDC_SUBJECTS=user:SUBJECT_A,user:SUBJECT_B
# If CURSOR_OIDC_SUBJECTS is set, it takes precedence over CURSOR_OIDC_SUBJECT.

# Optional: Cursor subjects authorized for sanity.rehearsal.write (capability-
# specific allowlist). Comma-separated; defaults to empty (no Sanity grants).
# Each value must also appear in CURSOR_OIDC_SUBJECT / CURSOR_OIDC_SUBJECTS.
# Identifier only — not a secret. See docs/milestone-sanity-rehearsal.md.
# SANITY_CURSOR_OIDC_SUBJECTS=user:SUBJECT_A

# --- GCE workload identity (broker authorization; non-secret) ---
# Verified Google OIDC `sub` for the GCE-attached service account (metadata identity).
# Used in broker policy as issuer alias `google` + this subject. Not a credential.
# Production: set the same name as a GitHub Environment variable on "production".
GCE_OIDC_SUBJECT=YOUR_GCE_SERVICE_ACCOUNT_SUBJECT

# --- Experiment 007 Phase 3: AWS S3 broker fulfillment (identifiers only) ---
# No AWS access keys. Role trusts Cloud Run runtime SA (make bootstrap-aws-s3).
# AWS_S3_ROLE_ARN contains an account ID — supply via GitHub Environment, do not commit.
# Defaults for bucket/region/audience also live in versions.env.
AWS_S3_ROLE_ARN=arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/pade-broker-experiment-007-s3-write
AWS_S3_BUCKET=after-certainty-rc-pade-007-1abcdf
AWS_S3_REGION=us-east-1
AWS_S3_AUDIENCE=https://pade-broker-aws-s3.after-certainty.aws

# Optional: override the predicted Cloud Run URL (custom domains are deferred)
# BROKER_URL=https://pade-broker-PROJECT_NUMBER.REGION.run.app

# Optional: immutable overlay tag (defaults to PADE_VERSION from versions.env).
# CI sets this to the full deployment-repo git SHA. Local deploys usually omit it.
# RUNTIME_IMAGE_TAG=0123456789abcdef0123456789abcdef01234567
# DEPLOYMENT_GIT_SHA=0123456789abcdef0123456789abcdef01234567

# Optional: override versions.env defaults
# REGION=us-central1
# SERVICE=pade-broker
# BROKER_IMAGE=ghcr.io/after-certainty/pade-broker
# PADE_REPO=https://github.com/After-Certainty/pade.git
# VERCEL_TOKEN_SECRET=vercel-token
# Optional static-token-file only: mount shared vercel-token on Cloud Run.
# Omit for recommended subject-secret-wif deploys (default).
# MOUNT_SHARED_VERCEL_TOKEN=1
