# Copy to .env and fill in. Never commit .env.
# No secrets belong here — only non-secret deployment identifiers.
# GitHub App PEM, GA service-account JSON, and Vercel access tokens go to
# Secret Manager via Make (secret-github-app / secret-ga-sa / secret-vercel-token),
# not this file. See docs/milestone-l-vercel.md for the Vercel token walkthrough.

# --- GCP (required) ---
PROJECT_ID=your-gcp-project-id
# Optional override; otherwise derived via gcloud from PROJECT_ID:
# PROJECT_NUMBER=123456789012

# --- GitHub App (non-secret IDs; PEM stays out of git) ---
# App ID and installation ID: GitHub → Settings → Developer settings → GitHub Apps
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_INSTALLATION_ID=your-installation-id
# Comma-separated owner/repo the App installation may mint tokens for
GITHUB_REPOSITORIES=owner/repo

# --- Google Analytics ---
# GA4 property resource name (Admin API / GA property settings)
GA_PROPERTY_ID=properties/123456789

# --- Cursor Cloud Agent identity ---
# From a Cursor Cloud Agent (identity socket present):
#   pade identity --audience "$(make -s predict-url)"
# Audience does not require the broker to be deployed yet.
CURSOR_OIDC_SUBJECT=user:YOUR_CURSOR_SUBJECT

# Optional: override the predicted Cloud Run URL (custom domains are deferred)
# BROKER_URL=https://pade-broker-PROJECT_NUMBER.REGION.run.app

# Optional: override versions.env defaults
# REGION=us-central1
# SERVICE=pade-broker
# BROKER_IMAGE=ghcr.io/ksteffe/pade-broker
# PADE_REPO=https://github.com/After-Certainty/pade.git
# VERCEL_TOKEN_SECRET=vercel-token
