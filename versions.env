# Released PADE broker (do not build pade-broker from source in this repo).
# Override via .env if you deploy a fork of PADE.
PADE_VERSION=v0.2.1
PADE_REF=d50174a2696743db3879dc98615801f5ad8d462a

# Upstream broker image (GHCR). Prefer digest pin for production deploys.
BROKER_IMAGE=ghcr.io/after-certainty/pade-broker
BROKER_IMAGE_DIGEST=sha256:3a17bcd0867e7666870d5e54e42b3cf6a39444d0c5227768fbe3baff0ae353af

# Exec provider source for PADE reference providers (cloned at image build time).
# Deployment-owned providers (e.g. Vercel) live under providers/ in this repo.
PADE_REPO=https://github.com/After-Certainty/pade.git

# Cloud Run / Artifact Registry naming
REGION=us-central1
SERVICE=pade-broker
AR_REPO=pade
RUNTIME_SA_NAME=pade-broker-runtime
# CI/CD deployer identity (GitHub Actions via WIF). Separate from runtime SA.
DEPLOYER_SA_NAME=pade-broker-deployer
# Workload Identity Federation pool / provider ids (bootstrap-github-wif)
WIF_POOL_ID=pade-broker-github
WIF_PROVIDER_ID=github

# Cursor OIDC → GCP WIF (runtime subject-bound authority; make bootstrap-cursor-wif).
# Distinct from GitHub Actions deployer WIF — do not conflate the two pools.
CURSOR_WIF_POOL_ID=pade-broker-cursor
CURSOR_WIF_PROVIDER_ID=cursor
CURSOR_OIDC_ISSUER=https://api.cursor.com
# Prefix for per-subject Vercel secrets (make secret-vercel-token-subject).
VERCEL_SUBJECT_SECRET_PREFIX=vercel-token-sub

# Secret Manager secret ids (values mounted as files at deploy — never in the image)
GITHUB_APP_KEY_SECRET=github-app-private-key
GA_SA_SECRET=google-analytics-sa
VERCEL_TOKEN_SECRET=vercel-token

DOCKER_PLATFORM=linux/amd64

# Private runtime overlay pushed to your project's Artifact Registry
RUNTIME_IMAGE_NAME=pade-broker-runtime
