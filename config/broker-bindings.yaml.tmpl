# Server-side exec bindings: broker fulfills capabilities via exec providers.
# Durable keys live in Secret Manager and are mounted under /run/secrets/ at deploy.
# Rendered by `make render-config` from this template + .env.
# GitHub/GA providers mint short-lived derived tokens; vercel.diagnostics returns
# static VERCEL_TOKEN Material (Milestone L — see docs/milestone-l-vercel.md).
version: "0.1"

capabilities:
  github.repo.read:
    provider: exec
    exec:
      command: ["/providers/pade-provider-github"]
      config:
        tokenEnv: GITHUB_TOKEN
        appId: "${GITHUB_APP_ID}"
        installationId: "${GITHUB_APP_INSTALLATION_ID}"
        privateKeyPath: "/run/secrets/github-app/private-key.pem"
        repositories:
${GITHUB_REPOSITORIES_YAML}
        permissions:
          metadata: read
          contents: read

  google-analytics.read:
    provider: exec
    exec:
      command: ["/providers/pade-provider-google-analytics"]
      config:
        tokenEnv: GA_ACCESS_TOKEN
        propertyId: "${GA_PROPERTY_ID}"
        serviceAccountFile: "/run/secrets/google-analytics/sa.json"
        scope: https://www.googleapis.com/auth/analytics.readonly

  # Deployment-owned Milestone M dogfood (opaque, non-normative capability id).
  # Subject-bound Material via Cursor → GCP WIF + per-subject Secret Manager IAM.
  # Requires broker v0.1.1+ (forwards verified identity). See docs/milestone-m-wif.md.
  # To revert to Milestone L shared authority, replace config with:
  #   tokenFile: "/run/secrets/vercel/token"
  #   tokenEnv: VERCEL_TOKEN
  vercel.diagnostics:
    provider: exec
    exec:
      command: ["/providers/pade-provider-vercel"]
      config:
        fulfillment: subject-secret-wif
        tokenEnv: VERCEL_TOKEN
        projectNumber: "${PROJECT_NUMBER}"
        poolId: "${CURSOR_WIF_POOL_ID}"
        providerId: "${CURSOR_WIF_PROVIDER_ID}"
        secretIdPrefix: "${VERCEL_SUBJECT_SECRET_PREFIX}"
