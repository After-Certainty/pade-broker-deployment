# Server-side exec bindings: broker fulfills capabilities via exec providers.
# Durable keys live in Secret Manager and are mounted under /run/secrets/ at deploy.
# Rendered by `make render-config` from this template + .env.
# GitHub/GA providers mint short-lived derived tokens; vercel.diagnostics returns
# subject-bound VERCEL_TOKEN Material via WIF (recommended; see docs/milestone-m-wif.md).
version: "0.1"

capabilities:
  github.repo.read:
    provider: exec
    exec:
      command: ["/providers/pade-provider-github"]
      config:
        tokenEnv: GITHUB_TOKEN
        appId: "${GITHUB_APP_ID}"
        installationId: "${GITHUB_APP_INSTALLATION_ID}"
        privateKeyPath: "/run/secrets/github-app/private-key.pem"
        repositories:
${GITHUB_REPOSITORIES_YAML}
        permissions:
          metadata: read
          contents: read

  google-analytics.read:
    provider: exec
    exec:
      command: ["/providers/pade-provider-google-analytics"]
      config:
        tokenEnv: GA_ACCESS_TOKEN
        propertyId: "${GA_PROPERTY_ID}"
        serviceAccountFile: "/run/secrets/google-analytics/sa.json"
        scope: https://www.googleapis.com/auth/analytics.readonly

  # Deployment-owned Vercel fulfillment (opaque, non-normative capability id).
  # Recommended path: subject-bound Material via Cursor → GCP WIF + per-subject Secret Manager IAM.
  # Requires broker v0.1.1+ (forwards verified identity). See docs/milestone-m-wif.md.
  # To revert to Milestone L shared authority, replace config with:
  #   tokenFile: "/run/secrets/vercel/token"
  #   tokenEnv: VERCEL_TOKEN
  vercel.diagnostics:
    provider: exec
    exec:
      command: ["/providers/pade-provider-vercel"]
      config:
        fulfillment: subject-secret-wif
        tokenEnv: VERCEL_TOKEN
        projectNumber: "${PROJECT_NUMBER}"
        poolId: "${CURSOR_WIF_POOL_ID}"
        providerId: "${CURSOR_WIF_PROVIDER_ID}"
        secretIdPrefix: "${VERCEL_SUBJECT_SECRET_PREFIX}"

  # Deployment-owned RadGnaRack Vercel authority (opaque, non-normative capability id).
  # Same provider binary as vercel.diagnostics; distinct secretIdPrefix so the same
  # Cursor subject can hold independent Vercel Material without overwriting the
  # existing vercel.diagnostics subject secret. See docs/milestone-m-wif.md and
  # docs/milestone-sanity-rehearsal.md (multi-authority note).
  # Capability name does not enforce read-only Vercel operations — downstream
  # credential authority remains authoritative.
  vercel.radgnarrack.read:
    provider: exec
    exec:
      command: ["/providers/pade-provider-vercel"]
      config:
        fulfillment: subject-secret-wif
        tokenEnv: VERCEL_TOKEN
        projectNumber: "${PROJECT_NUMBER}"
        poolId: "${CURSOR_WIF_POOL_ID}"
        providerId: "${CURSOR_WIF_PROVIDER_ID}"
        secretIdPrefix: "${RADGNARRACK_VERCEL_SUBJECT_SECRET_PREFIX}"

  # Deployment-owned Sanity rehearsal fulfillment (opaque, non-normative capability id).
  # subject-secret-wif only: Cursor → GCP WIF → per-subject Secret Manager IAM.
  # Capability name does not mediate individual Sanity operations; downstream
  # credential authority remains authoritative. Project/dataset are consumer config.
  # See docs/milestone-sanity-rehearsal.md.
  sanity.rehearsal.write:
    provider: exec
    exec:
      command: ["/providers/pade-provider-sanity"]
      config:
        fulfillment: subject-secret-wif
        tokenEnv: SANITY_API_TOKEN
        projectNumber: "${PROJECT_NUMBER}"
        poolId: "${CURSOR_WIF_POOL_ID}"
        providerId: "${CURSOR_WIF_PROVIDER_ID}"
        secretIdPrefix: "${SANITY_SUBJECT_SECRET_PREFIX}"

  # Deployment-owned AWS S3 fulfillment (Experiment 007 Phase 3).
  # Caller Google/GCE identity authorizes the capability; Cloud Run runtime
  # identity federates to AWS STS. No AWS access keys in config.
  # See docs/experiment-007-phase-3.md.
  aws.s3.bucket.write:
    provider: exec
    exec:
      command: ["/providers/pade-provider-aws-s3"]
      config:
        roleArn: "${AWS_S3_ROLE_ARN}"
        region: "${AWS_S3_REGION}"
        bucket: "${AWS_S3_BUCKET}"
        prefix: "experiment-007/"
        audience: "${AWS_S3_AUDIENCE}"
