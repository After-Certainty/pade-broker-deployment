# Server-owned broker authorization policy.
# Rendered by `make render-config` from this template + .env. Does not contain credentials.
#
# oidc.audience is the Cloud Run URL (`make predict-url`, or BROKER_URL in .env).
# Subjects come from CURSOR_OIDC_SUBJECT or comma-separated CURSOR_OIDC_SUBJECTS
# (`pade identity --audience <BROKER_URL>`). Multiple subjects enable Milestone M
# A/B dogfood of the same capabilities.
#
# requireRepoURLs: false until Cursor attests complete repo_urls
# (managed Cloud Agents often lack the full set).
version: "0.1"

oidc:
  issuer: https://api.cursor.com
  audience: ${BROKER_URL}
  # jwksURL defaults to https://api.cursor.com/keys when omitted

policies:
${CURSOR_OIDC_POLICIES_YAML}
